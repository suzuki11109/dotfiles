{
  "$schema": "https://eca.dev/config.json",
  "providers": {
    "deepseek": {
      "api": "openai-chat",
      "url": "https://api.deepseek.com",
      "keyRc": "deepseek.com",
      "models": {
        "deepseek-chat": {},
        "deepseek-flash": {},
        "deepseek-v4-pro": {}
      }
    },
    "9router": {
      "api": "openai-chat",
      "url": "http://localhost:20128/v1",
      "httpClient": {
        "version": "http-1.1"
      },
      "models": {}
    }
  },
  "skills": [
    {
      "path": "/Users/aki/.claude/skills"
    }
  ],
  "hooks": {
    "rtk-rewrite-shell": {
      "type": "preToolCall",
      "matcher": "eca__shell_command",
      "visible": false,
      "description": "Rewrite supported shell commands with RTK",
      "actions": [
        {
          "type": "shell",
          "file": "~/.config/eca/hooks/rtk-rewrite.sh",
          "timeout": 3000
        }
      ]
    }
  },
  "defaultModel": "deepseek/deepseek-flash",
  "defaultAgent": "code"
}
